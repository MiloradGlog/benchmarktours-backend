NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/benchmarktours
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS - Comma-separated list of allowed origins for production
# Example: ALLOWED_ORIGINS=https://admin.example.com,https://mobile.example.com
ALLOWED_ORIGINS=

# Google Cloud Storage
GOOGLE_INPUT_STORAGE_BUCKET=your-storage-bucket-name
GOOGLE_STORAGE_SERVICE_ACCOUNT_KEY={"type":"service_account"...}

# Frontend URLs
ADMIN_WEB_URL=http://localhost:3003

# AI Service Configuration
# Choose your AI provider: 'openai' or 'gemini'
AI_PROVIDER=openai

# For OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
# For Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Model Configuration
# For OpenAI: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
# For Gemini: gemini-2.5-flash, gemini-2.5-pro, gemini-2.5-flash-lite
# Legacy: gemini-2.0-flash-exp, gemini-1.5-pro
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2000

# LangSmith Configuration (optional - for monitoring)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=ls-your-langsmith-api-key-here
LANGSMITH_PROJECT=your-project-name
LANGSMITH_API_URL=https://api.smith.langchain.com

# AI Feature Flags
AI_ENABLED=true
AI_APPROVAL_REQUIRED=true
AI_MAX_SCHEDULE_CHANGES=50